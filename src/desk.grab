use json
use server

# ==============================================================================
# Groxy Desk v1.2.0 — Companion GRAB Contract Manifest
# Verifies template bindings & health route schema against GRAB v1.1.0.
# ==============================================================================

set initial_theme to "light"

route "GET" "/_health"
  give back server.json using 200, record {ok: yes, status: "ok", service: "groxy-desk", version: "1.2.0", bind: "127.0.0.1"}
end

route "GET" "/"
  give back server.html using "../views/workbench.grab.html", record {initial_theme: initial_theme}
end
